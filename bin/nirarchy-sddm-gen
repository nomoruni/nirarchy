#!/usr/bin/env python3
"""nirarchy-sddm-gen: Generate SDDM theme variants for all Nirarchy themes."""

import sys, os, shutil, tomllib
from pathlib import Path

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    print("ERROR: Pillow required: pip install Pillow")
    sys.exit(1)

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local")) / "share" / "nirarchy"
THEMES_DIR = DATA / "themes"
OUT_DIR = DATA / "sddm-themes"
ASSETS_DIR = DATA / "default" / "sddm" / "nirarchy"

FONT_CANDIDATES = [
    str(Path.home() / ".local/share/fonts/Doto-ExtraBold.ttf"),
    str(Path.home() / "Projects/nirarchy/data/fonts/Doto-ExtraBold.ttf"),
    "/usr/share/fonts/TTF/Doto-ExtraBold.ttf",
]
FONT = next((f for f in FONT_CANDIDATES if os.path.exists(f)), None)

QML = '''import QtQuick 2.0
import SddmComponents 2.0

Rectangle {{
  id: root
  width: 640
  height: 480
  color: "{bg}"

  property string currentUser: userModel.lastUser
  property bool loginFailed: false
  property int sessionIndex: {{
    for (var i = 0; i < sessionModel.rowCount(); i++) {{
      var name = (sessionModel.data(sessionModel.index(i, 0), Qt.DisplayRole) || "").toString()
      if (name.indexOf("uwsm") !== -1) return i
    }}
    return sessionModel.lastIndex
  }}

  Connections {{
    target: sddm
    function onLoginFailed() {{ root.loginFailed = true; password.text = ""; password.focus = true }}
    function onLoginSucceeded() {{ root.loginFailed = false }}
  }}

  Column {{
    anchors.centerIn: parent
    spacing: 40

    Image {{
      id: logo
      source: "logo.png"
      width: Math.min(sourceSize.width, root.width * 0.8)
      height: sourceSize.width > 0 ? Math.round(width * sourceSize.height / sourceSize.width) : 0
      fillMode: Image.PreserveAspectFit
      anchors.horizontalCenter: parent.horizontalCenter
    }}

    Row {{
      anchors.horizontalCenter: parent.horizontalCenter
      spacing: 15

      Image {{
        source: root.loginFailed ? "lock-failed.png" : "lock.png"
        width: 34; height: 38
        fillMode: Image.PreserveAspectFit
        anchors.verticalCenter: parent.verticalCenter
      }}

      Item {{
        width: entry.width; height: entry.height

        Image {{
          id: entry
          source: root.loginFailed ? "entry-failed.png" : "entry.png"
          anchors.centerIn: parent
        }}

        Row {{
          anchors.left: parent.left; anchors.leftMargin: 20
          anchors.verticalCenter: parent.verticalCenter; spacing: 5
          Repeater {{
            model: Math.min(password.text.length, 21)
            Image {{ source: "bullet.png"; width: 7; height: 7 }}
          }}
        }}

        TextInput {{
          id: password
          anchors.fill: parent; anchors.leftMargin: 20; anchors.rightMargin: 20
          verticalAlignment: TextInput.AlignVCenter
          echoMode: TextInput.Password
          font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 24; font.letterSpacing: 5
          passwordCharacter: "\\u2022"
          color: "transparent"; selectionColor: "transparent"; selectedTextColor: "transparent"
          cursorDelegate: Item {{}}
          focus: true
          onTextChanged: root.loginFailed = false
          Keys.onPressed: {{
            if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter)
              sddm.login(root.currentUser, password.text, root.sessionIndex)
          }}
        }}
      }}
    }}
  }}
  Component.onCompleted: password.forceActiveFocus()
}}
'''

METADATA = '''[SddmGreeterTheme]
Name=Nirarchy ({title})
Description=Nirarchy SDDM theme for {title}
Author=Nirarchy
Type=sddm-theme
Version=1.0
QtVersion=6
ThemeEntry=theme.conf
'''

SHARED_ASSETS = []  # No longer copying static assets — all generated per-theme


def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))


def make_logo(text, accent, path):
    color = hex_rgb(accent) + (255,)
    img = Image.new("RGBA", (800, 188), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    best = None
    for sz in range(170, 10, -2):
        f = ImageFont.truetype(FONT, sz)
        bb = draw.textbbox((0, 0), text, font=f)
        w, h = bb[2] - bb[0], bb[3] - bb[1]
        if w < 750 and h < 170:
            best = (sz, w, h, bb, f)
            break
    if best:
        sz, w, h, bb, f = best
        x = (800 - w) // 2
        y = (188 - h) // 2 - bb[1]
        draw.text((x, y), text, fill=color, font=f)
    img.save(path)


def make_entry(bg, border, path):
    c_bg = hex_rgb(bg) + (200,)
    c_bd = hex_rgb(border) + (255,)
    img = Image.new("RGBA", (286, 48), (0, 0, 0, 0))
    ImageDraw.Draw(img).rectangle([0, 0, 285, 47], fill=c_bg, outline=c_bd, width=1)
    img.save(path)


def make_entry_failed(bg, border, path):
    c_bg = hex_rgb(bg) + (200,)
    c_bd = hex_rgb(border) + (255,)
    img = Image.new("RGBA", (286, 48), (0, 0, 0, 0))
    ImageDraw.Draw(img).rectangle([0, 0, 285, 47], fill=c_bg, outline=c_bd, width=1)
    img.save(path)


def make_lock(fg, path):
    """Generate lock icon with theme foreground color."""
    c = hex_rgb(fg) + (255,)
    img = Image.new("RGBA", (84, 96), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    # Lock body
    draw.rounded_rectangle([16, 42, 68, 82], radius=4, fill=c)
    # Lock shackle
    draw.arc([24, 14, 60, 54], start=180, end=0, fill=c, width=5)
    draw.rectangle([24, 32, 36, 50], fill=c)
    draw.rectangle([48, 32, 60, 50], fill=c)
    img.save(path)


def make_lock_failed(fg, path):
    """Generate failed lock icon with theme foreground color."""
    c = hex_rgb(fg) + (255,)
    img = Image.new("RGBA", (84, 96), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)
    # Lock body
    draw.rounded_rectangle([16, 42, 68, 82], radius=4, fill=c)
    # Lock shackle
    draw.arc([24, 14, 60, 54], start=180, end=0, fill=c, width=5)
    draw.rectangle([24, 32, 36, 50], fill=c)
    draw.rectangle([48, 32, 60, 50], fill=c)
    # X mark
    draw.line([34, 56, 50, 72], fill=(0, 0, 0, 255), width=3)
    draw.line([50, 56, 34, 72], fill=(0, 0, 0, 255), width=3)
    img.save(path)


def make_bullet(fg, path):
    """Generate bullet dot with theme foreground color."""
    c = hex_rgb(fg) + (255,)
    img = Image.new("RGBA", (14, 14), (0, 0, 0, 0))
    ImageDraw.Draw(img).ellipse([1, 1, 12, 12], fill=c)
    img.save(path)


def main():
    if not FONT:
        print("ERROR: No suitable font found (Doto or Montserrat)")
        sys.exit(1)

    OUT_DIR.mkdir(parents=True, exist_ok=True)

    for theme_dir in sorted(THEMES_DIR.iterdir()):
        if not theme_dir.is_dir():
            continue
        colors_file = theme_dir / "colors.toml"
        if not colors_file.exists():
            continue

        name = theme_dir.name
        with open(colors_file, "rb") as f:
            c = tomllib.load(f)

        bg = c.get("background", "#1a1b26")
        accent = c.get("accent", "#89b4fa")
        fg = c.get("foreground", "#ffffff")
        color1 = c.get("color1", "#f38ba8")
        color8 = c.get("color8", "#585b70")

        out = OUT_DIR / name
        out.mkdir(parents=True, exist_ok=True)

        (out / "Main.qml").write_text(QML.format(bg=bg))
        (out / "metadata.desktop").write_text(METADATA.format(title=name.replace("-", " ").title()))
        make_logo("nirarchy", accent, out / "logo.png")
        make_entry(bg, color8, out / "entry.png")
        make_entry_failed(bg, color1, out / "entry-failed.png")
        make_lock(fg, out / "lock.png")
        make_lock_failed(fg, out / "lock-failed.png")
        make_bullet(fg, out / "bullet.png")

        print(f"  {name}")

    print(f"\nGenerated {len(list(OUT_DIR.iterdir()))} themes in {OUT_DIR}")


if __name__ == "__main__":
    main()
