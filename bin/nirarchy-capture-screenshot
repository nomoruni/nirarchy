#!/bin/bash
# nirarchy-capture-screenshot: Take a screenshot (smart|region|fullscreen) with optional satty editing

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${NIRARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
mkdir -p "$OUTPUT_DIR"

pkill slurp 2>/dev/null && exit 0

MODE="${1:-smart}"

get_rectangles() {
  niri msg --json outputs 2>/dev/null | jq -r '
    .[] | .logical | "\(.x),\(.y) \(.width)x\(.height)"'
  niri msg --json windows 2>/dev/null | jq -r '
    .[]
    | if .layout.floating then
        "\(.layout.floating.pos.x),\(.layout.floating.pos.y) \(.layout.floating.size.width)x\(.layout.floating.size.height)"
      elif .layout.tile then
        "\(.layout.tile.x),\(.layout.tile.y) \(.layout.tile.width)x\(.layout.tile.height)"
      else empty end'
}

case "$MODE" in
region)
  SELECTION=$(slurp 2>/dev/null)
  ;;
fullscreen)
  SELECTION=$(niri msg --json focused-output 2>/dev/null | jq -r '.logical | "\(.x),\(.y) \(.width)x\(.height)"' 2>/dev/null)
  [[ -z $SELECTION ]] && SELECTION=$(get_rectangles | head -n1)
  ;;
smart | *)
  RECTS=$(get_rectangles)
  SELECTION=$(echo "$RECTS" | slurp 2>/dev/null)

  if [[ $SELECTION =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    if ((${BASH_REMATCH[3]} * ${BASH_REMATCH[4]} < 20)); then
      click_x="${BASH_REMATCH[1]}"
      click_y="${BASH_REMATCH[2]}"

      while IFS= read -r rect; do
        if [[ $rect =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
          rect_x="${BASH_REMATCH[1]}"
          rect_y="${BASH_REMATCH[2]}"
          rect_width="${BASH_REMATCH[3]}"
          rect_height="${BASH_REMATCH[4]}"

          if ((click_x >= rect_x && click_x < rect_x + rect_width && click_y >= rect_y && click_y < rect_y + rect_height)); then
            SELECTION="${rect_x},${rect_y} ${rect_width}x${rect_height}"
            break
          fi
        fi
      done <<<"$RECTS"
    fi
  fi
  ;;
esac

[[ -z $SELECTION ]] && exit 0

FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"

grim -g "$SELECTION" "$FILEPATH" || exit 1

wl-copy <"$FILEPATH"
notify-send -u low "Screenshot saved to clipboard and file" "$FILEPATH" -i "$FILEPATH" -t 5000

(
  sleep 0.5
  satty --filename "$FILEPATH" \
    --output-filename "$FILEPATH" \
    --actions-on-enter save-to-clipboard \
    --save-after-copy \
    --copy-command 'wl-copy' >/dev/null 2>&1
) &
