#!/bin/bash
# nirarchy-pkg-aur-install: fzf picker to install AUR packages via paru

fzf_args=(
  --multi
  --preview 'paru -Saa {1}'
  --preview-window 'down:65%:wrap'
)

pkg_names=$(paru -Slqa | sort -u | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  echo "$pkg_names" | tr '\n' ' ' | xargs paru -S --needed --noconfirm
  nirarchy-show-done
fi
