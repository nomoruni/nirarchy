#!/bin/bash
# nirarchy-pkg-remove: fzf picker to remove installed packages

fzf_args=(
  --multi
  --preview 'paru -Qi {1}'
  --preview-window 'down:65%:wrap'
)

pkg_names=$(paru -Qqe | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
  nirarchy-show-done
fi
