#!/usr/bin/env python3
# nirarchy-float-watch: float Nirarchy TUI windows (btop, wiremix, impala, bluetui).
# foot sets app-id/title after niri evaluates opening window-rules, so open-floating
# never matches; this watches the event stream and floats matching windows via CLI.
# Official approach from https://github.com/niri-wm/niri/discussions/1599

import json
import os
import re
import subprocess
import sys
import time

RULE = re.compile(os.environ.get("NIRARCHY_FLOAT_RE", r"^org\.nirarchy\."))
SIZES = {
    "org.nirarchy.btop": (1000, 620),
    "_default": (800, 500),
}

p = subprocess.Popen(
    ["niri", "msg", "--json", "event-stream"],
    stdout=subprocess.PIPE,
    text=True,
)


def cli(*args):
    subprocess.run(["niri", "msg", "action", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


floated = set()

for line in p.stdout:
    try:
        ev = json.loads(line)
    except json.JSONDecodeError:
        continue

    w = ev.get("WindowOpenedOrChanged", {}).get("window")
    if not w:
        continue

    wid = w.get("id")
    title = w.get("title") or ""
    app_id = w.get("app_id") or ""

    if wid is None or wid in floated:
        continue
    if not (RULE.search(title) or RULE.search(app_id)):
        continue

    time.sleep(0.15)
    cli("focus-window", "--id", str(wid))
    cli("move-window-to-floating")

    key = app_id if app_id in SIZES else title if title in SIZES else "_default"
    width, height = SIZES[key]
    cli("set-window-width", "--", str(width))
    cli("set-window-height", "--", str(height))

    floated.add(wid)
