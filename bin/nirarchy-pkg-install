#!/bin/bash
# nirarchy-pkg-install: fzf picker to install repo packages

fzf_args=(
  --multi
  --preview 'pacman -Sii {1}'
  --preview-window 'down:65%:wrap'
)

pkg_names=$(pacman -Slq | sort -u | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --needed --noconfirm
  nirarchy-show-done
fi
