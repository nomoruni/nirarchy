#!/bin/bash
# nirarchy-restart-walker: Restart walker and elephant

pkill -f "walker --gapplication-service" 2>/dev/null
pkill -x walker 2>/dev/null
pkill -x elephant 2>/dev/null
sleep 0.3
setsid elephant >/dev/null 2>&1 &
sleep 0.5
setsid env GSK_RENDERER=cairo walker --gapplication-service >/dev/null 2>&1 &
