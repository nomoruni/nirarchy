#!/bin/bash
# nirarchy-capture-screenrecording: Screen recording via gpu-screen-recorder

STOP=false
AUDIO_ARGS=()

while (($# > 0)); do
  case "$1" in
  --stop-recording) STOP=true ;;
  --with-desktop-audio) AUDIO_ARGS+=("$(pactl get-default-sink).monitor") ;;
  --with-microphone-audio) AUDIO_ARGS+=("$(pactl get-default-source)") ;;
  esac
  shift
done

if $STOP; then
  pkill -SIGINT -f "^gpu-screen-recorder" && notify-send -u normal "Screen recording" "Stopped and saved to ~/Videos" || notify-send -u low "Screen recording" "Not recording"
  exit 0
fi

if pgrep -f "^gpu-screen-recorder" >/dev/null; then
  notify-send -u low "Screen recording" "Already recording"
  exit 1
fi

mkdir -p "$HOME/Videos"
OUTPUT="$HOME/Videos/recording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"

args=(-w screen -f 60 -o "$OUTPUT")
for src in "${AUDIO_ARGS[@]}"; do
  args+=(-a "$src")
done

setsid gpu-screen-recorder "${args[@]}" >/dev/null 2>&1 &

sleep 3
if pgrep -f "^gpu-screen-recorder" >/dev/null; then
  notify-send -u normal "Screen recording started" "$OUTPUT"
else
  notify-send -u critical "Screen recording failed"
fi
