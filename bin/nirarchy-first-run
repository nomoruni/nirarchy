#!/bin/bash
# nirarchy-first-run: One-time welcome notification on first niri login

MARKER="$HOME/.cache/nirarchy/firstrun"
[[ -f $MARKER ]] && exit 0
mkdir -p "$HOME/.cache/nirarchy"
touch "$MARKER"

sleep 2
notify-send -u normal "Welcome to Nirarchy" "Super + Alt + Space → Nirarchy menu\nSuper + Space → App launcher\nSuper + K → Keybindings\nSuper + Shift + A → opencode AI agent" -t 15000
