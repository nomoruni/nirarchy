[Unit]
Description=Float Nirarchy TUI windows (niri event-stream watcher)
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/nirarchy-float-watch
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
